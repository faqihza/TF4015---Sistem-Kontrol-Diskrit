% ===========================================================================
% Tema Beamer TF4015 Sistem Kontrol Diskrit
% Pemakaian: \usetheme{skd}  (letakkan file ini di folder yang sama dengan slide)
% ===========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeskd}[2026/11/06 Tema TF4015 SKD]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{booktabs}
\RequirePackage{array}
\pgfplotsset{compat=1.17}
\usetikzlibrary{arrows.meta,positioning,calc,fit,shapes.geometric,decorations.pathreplacing}

% ---------------------------------------------------------------------------
% Warna
% ---------------------------------------------------------------------------
\definecolor{skdblue}{HTML}{1F3A68}
\definecolor{skdmid}{HTML}{3D6DB5}
\definecolor{skdlight}{HTML}{E8EEF7}
\definecolor{skdorange}{HTML}{D9822B}
\definecolor{skdgreen}{HTML}{2E8B57}
\definecolor{skdred}{HTML}{B03A2E}
\definecolor{skdgray}{HTML}{6B7280}

\setbeamercolor{normal text}{fg=black!88}
\setbeamercolor{structure}{fg=skdblue}
\setbeamercolor{alerted text}{fg=skdorange}
\setbeamercolor{frametitle}{fg=skdblue,bg=white}
\setbeamercolor{framesubtitle}{fg=skdgray}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=white!85!skdblue}
\setbeamercolor{block title}{fg=white,bg=skdblue}
\setbeamercolor{block body}{fg=black!88,bg=skdlight}
\setbeamercolor{block title alerted}{fg=white,bg=skdorange}
\setbeamercolor{block body alerted}{fg=black!88,bg=skdorange!10}
\setbeamercolor{block title example}{fg=white,bg=skdgreen}
\setbeamercolor{block body example}{fg=black!88,bg=skdgreen!10}
\setbeamercolor{item}{fg=skdorange}
\setbeamercolor{footline}{fg=white,bg=skdblue}

% ---------------------------------------------------------------------------
% Font dan elemen umum
% ---------------------------------------------------------------------------
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,shape=\itshape}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}{\raggedright\insertcaption\par}
\setbeamersize{text margin left=1.1cm,text margin right=1.1cm}

% ---------------------------------------------------------------------------
% Judul frame: garis aksen di bawah judul
% ---------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
	\vspace*{0.35cm}%
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=1.1cm,rightskip=1.1cm]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle\par
		\ifx\insertframesubtitle\@empty\else
			\vspace{1pt}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
		\fi
	\end{beamercolorbox}%
	\vspace{-2pt}%
	\hspace*{1.1cm}{\color{skdorange}\rule{1.6cm}{2pt}}%
	\vspace{0.1cm}%
}

% ---------------------------------------------------------------------------
% Footline
% ---------------------------------------------------------------------------
\setbeamertemplate{footline}{%
	\begin{beamercolorbox}[wd=\paperwidth,ht=0.55cm,dp=0.2cm,leftskip=0.4cm,rightskip=0.4cm]{footline}
		\tiny TF4015 Sistem Kontrol Diskrit\hfill\insertshorttitle\hfill\insertframenumber/\inserttotalframenumber
	\end{beamercolorbox}%
}

% ---------------------------------------------------------------------------
% Halaman judul
% ---------------------------------------------------------------------------
\setbeamertemplate{title page}{%
	\begin{tikzpicture}[remember picture,overlay]
		\fill[skdblue] (current page.south west) rectangle (current page.north east);
		\fill[skdorange] ([yshift=-0.2cm]current page.west) rectangle ++(\paperwidth,0.08cm);
		\node[anchor=south west,text width=0.85\paperwidth,align=left,inner sep=0]
			at ([xshift=1.1cm,yshift=0.4cm]current page.west) {%
				{\color{white!75!skdblue}\small TF4015 Sistem Kontrol Diskrit \textbar\ \en{Discrete-Time Control Systems}}\\[0.35cm]
				{\usebeamerfont{title}\usebeamercolor[fg]{title}\LARGE\bfseries\hyphenpenalty=10000\inserttitle}\\[0.2cm]
				{\usebeamercolor[fg]{subtitle}\large\itshape\insertsubtitle}};
		\node[anchor=north west,text width=0.85\paperwidth,align=left,inner sep=0,text=white]
			at ([xshift=1.1cm,yshift=-0.6cm]current page.west) {%
				\small\insertauthor\\[0.15cm]
				{\color{white!75!skdblue}\footnotesize\insertinstitute}\\[0.15cm]
				{\color{white!75!skdblue}\footnotesize\insertdate}};
	\end{tikzpicture}%
}

% ---------------------------------------------------------------------------
% Halaman pemisah bagian (otomatis di setiap \section)
% ---------------------------------------------------------------------------
\AtBeginSection[]{%
	{\setbeamertemplate{footline}{}
	\begin{frame}[plain,noframenumbering]
		\begin{tikzpicture}[remember picture,overlay]
			\fill[skdlight] (current page.south west) rectangle (current page.north east);
			\fill[skdblue] (current page.south west) rectangle ([xshift=0.35cm]current page.north west);
			\node[anchor=west,text width=0.8\paperwidth,align=left,execute at begin node={\hyphenpenalty=10000}]
				at ([xshift=1.4cm]current page.west) {%
					{\color{skdorange}\large\bfseries Bagian \thesection}\\[0.2cm]
					{\color{skdblue}\LARGE\bfseries\insertsectionhead}};
		\end{tikzpicture}
	\end{frame}}
}

% ---------------------------------------------------------------------------
% Makro bilingual dan bantu
% ---------------------------------------------------------------------------
% Istilah Inggris (miring, abu-abu)
\newcommand{\en}[1]{{\color{skdgray}\textit{#1}}}
% Istilah kunci: Indonesia (Inggris)
\newcommand{\term}[2]{\textbf{#1} \en{(#2)}}
% Kotak ringkasan kecil
\newcommand{\kunci}[1]{%
	\begin{center}
		\colorbox{skdorange!12}{\parbox{0.92\linewidth}{\centering\small #1}}
	\end{center}}

% Gaya diagram blok
\tikzset{
	blk/.style={draw=skdblue,thick,fill=white,rounded corners=2pt,minimum height=0.9cm,minimum width=1.6cm,align=center,font=\small},
	blkd/.style={blk,fill=skdlight},
	sum/.style={draw=skdblue,thick,circle,inner sep=0pt,minimum size=0.45cm},
	sig/.style={-{Stealth[length=2.2mm]},thick,skdblue},
	lbl/.style={font=\scriptsize,text=skdgray},
}

% Gaya grafik
\pgfplotsset{
	skd/.style={
		axis lines=left,
		grid=major,
		grid style={black!10},
		tick label style={font=\scriptsize},
		label style={font=\small},
		legend style={font=\scriptsize,draw=none,fill=white,fill opacity=0.85,text opacity=1},
		every axis plot/.append style={thick},
		cycle list={{skdblue},{skdorange},{skdgreen},{skdred}},
	},
}

\endinput
